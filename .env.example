# Copy to .env and fill. .env is gitignored.
# Dev: direct Neon URL. Production: use the -pooler.neon.tech URL with pool.max:3.
DATABASE_URI=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
PAYLOAD_SECRET=generate_a_long_random_string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Media on Hostinger local disk: absolute path OUTSIDE the release folder so
# uploads survive redeploys (e.g. /home/<user>/domains/apturio.com/media).
# MEDIA_DIR=
# Email via SMTP (Hostinger mailbox). Takes priority over Resend when set.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=noreply@apturio.com
# SMTP_PASS=
# SMTP_FROM_NAME=Apturio
# SMTP_FROM_ADDRESS=noreply@apturio.com
# Fallback email via Resend (needs the sender domain verified in Resend):
# RESEND_API_KEY=
# Optional media offload (Cloudflare R2 / S3). Takes over from MEDIA_DIR when all four are set:
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
